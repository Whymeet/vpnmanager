#!/bin/bash
# Go клона для разработки: тот же тулчейн и то же окружение, что у сборки в
# setup/macos/prepare.sh. Пример: tools/go test ./...
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -x "$REPO/.toolchain/go/bin/go" ] || { echo "Go клона не найден — сначала ./setup/macos/prepare.sh" >&2; exit 1; }
export GOENV=off GOTOOLCHAIN=local CGO_ENABLED=0 GOPATH="$REPO/.toolchain/gopath" GOCACHE="$REPO/.toolchain/cache"
exec "$REPO/.toolchain/go/bin/go" "$@"
